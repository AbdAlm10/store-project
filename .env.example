# Copy to .env.local. Never commit real secrets.

# Public site
NEXT_PUBLIC_APP_NAME=دكّان
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Supabase (server). Production refuses to boot when these are missing
# unless ENABLE_DEMO_MODE=true.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — server only, rotate if leaked.
# It is also required to persist support auto-replies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# In-memory demo. Local development and tests use it without this flag.
# Production uses it only when this is exactly "true".
# Demo accounts (local only): merchant@alnoor.demo / admin@yourstore.app
# Password: password123
ENABLE_DEMO_MODE=

# Signs the demo-mode session cookie. Required if the demo is reachable
# beyond a single process; generate with: openssl rand -hex 32
MEMORY_SESSION_SECRET=

# Extra OAuth redirect origins, comma-separated (preview deploys).
# The request Host header is never trusted. Also add each origin's
# /auth/callback URL in the Supabase Auth redirect allowlist.
OAUTH_ALLOWED_ORIGINS=

# Shared rate limits. When both are set, limits use Upstash Redis REST.
# Otherwise each server process keeps its own in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dashboard subscription test actions. Requires exactly "true" and a
# non-production process. Leave unset on the production host.
ENABLE_SUBSCRIPTION_TEST_ACTIONS=

# Sentry (optional). Auth token is used at build time to upload source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
